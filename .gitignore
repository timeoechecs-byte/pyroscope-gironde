# ── Environment files (CRITICAL — never commit secrets) ──────────────
.env
.env.*
!.env.example
!.env.template

# ── Copernicus / ECMWF credentials ────────────────────────────────────
.cdsapirc

# ── Private keys, certificates, anything PEM-shaped ──────────────────
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# ── Belt-and-suspenders for secret filenames ──────────────────────────
*secrets*
*credentials*
*Secrets.*
*Credentials.*

# ── Dependencies ──────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js
.bun/

# ── Build outputs ─────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.vite/

# ── Convex generated (auto-restored by `convex dev`) ──────────────────
src/convex/_generated/

# ── Logs ──────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Coverage / test reports ───────────────────────────────────────────
coverage/
.nyc_output/

# ── Editor / OS junk ──────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db
